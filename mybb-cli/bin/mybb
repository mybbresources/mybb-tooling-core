#!/usr/bin/env php
<?php
declare(strict_types=1);
$loaded=false;for($dir=__DIR__;$dir!==dirname($dir);$dir=dirname($dir)){$siteAutoload=$dir.'/inc/plugins/mybb-tooling/autoload.php';if(is_file($siteAutoload)){require $siteAutoload;$loaded=true;break;}}if(!$loaded)for($dir=__DIR__;$dir!==dirname($dir);$dir=dirname($dir))if(is_file($dir.'/vendor/autoload.php')){require $dir.'/vendor/autoload.php';$loaded=true;break;}if(!$loaded){$fallback=dirname(__DIR__,2).'/autoload.php';if(!is_file($fallback)){fwrite(STDERR,"Shared tooling package is missing; install this project with Composer.\n");exit(1);}require $fallback;}
use MyBB\Tooling\PackageManager;
use MyBB\Tooling\CatalogClient;
use MyBB\Tooling\CatalogException;
use MyBB\Tooling\DatabaseTools;

function jsonMode(): bool { return in_array('--json',$GLOBALS['argv'],true); }
function emit(array $v,int $exit=0): never { echo jsonMode()?json_encode($v,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES)."\n":implode("\n",array_map(fn($k)=>$k.': '.(is_scalar($v[$k]??null)?(string)$v[$k]:json_encode($v[$k])),array_keys($v)))."\n"; exit($exit); }
function writePlan(string $title,array $sections):void{fwrite(STDERR,MyBB\Installer\InstallPlanOutput::render($title,$sections));}
function resolveTargetPath(string $requested): string { $path=rtrim($requested,"/\\");if($path==='')$path=DIRECTORY_SEPARATOR;if($path==='.')$path=getcwd();elseif($path==='..')$path=dirname(getcwd());if($path===DIRECTORY_SEPARATOR||preg_match('/^[A-Za-z]:$/',$path))throw new RuntimeException('Refusing filesystem root as install target');if(is_link($path))throw new RuntimeException('Target directory cannot be a symlink');$leaf=basename($path);if($leaf===''||$leaf==='.'||$leaf==='..')throw new RuntimeException('Target path must name a directory');$parent=realpath(dirname($path));if($parent===false)throw new RuntimeException('Target parent directory must already exist');$resolved=$parent.DIRECTORY_SEPARATOR.$leaf;if(is_link($resolved))throw new RuntimeException('Target directory cannot be a symlink');if(file_exists($resolved)){if(!is_dir($resolved))throw new RuntimeException('Target must be a directory');$resolved=realpath($resolved);if($resolved===false)throw new RuntimeException('Cannot resolve target directory');}$normalized=str_replace('\\','/',$resolved);if($normalized==='/'||preg_match('#^/(etc|usr|bin|sbin|System|Library)(/|$)#i',$normalized)||preg_match('#^[A-Za-z]:/(Windows|Program Files|Program Files \(x86\)|System32)(/|$)#i',$normalized))throw new RuntimeException('Refusing unsafe target directory');$home=getenv('HOME');if($home&&realpath($home)!==false&&$normalized===str_replace('\\','/',realpath($home)))throw new RuntimeException('Refusing the home directory as install target');return $resolved; }
function fetch(string $url,int $limit=4194304): string { if(!str_starts_with($url,'https://'))throw new RuntimeException('HTTPS is required'); $host=parse_url($url,PHP_URL_HOST); if(!in_array($host,['mybb.com','www.mybb.com','resources.mybb.com'],true))throw new RuntimeException('Refusing non-official host'); $ch=curl_init($url);$buf='';curl_setopt_array($ch,[CURLOPT_FOLLOWLOCATION=>false,CURLOPT_CONNECTTIMEOUT=>10,CURLOPT_TIMEOUT=>45,CURLOPT_SSL_VERIFYPEER=>true,CURLOPT_SSL_VERIFYHOST=>2,CURLOPT_USERAGENT=>'mybb-installer-cli/0.1 (+https://mybbresources.com)',CURLOPT_WRITEFUNCTION=>function($c,$chunk)use(&$buf,$limit){$buf.=$chunk;if(strlen($buf)>$limit)return 0;return strlen($chunk);}]);$ok=curl_exec($ch);$code=curl_getinfo($ch,CURLINFO_RESPONSE_CODE);$err=curl_error($ch);curl_close($ch);if($ok===false||$code<200||$code>=300)throw new RuntimeException('Official download request failed: '.$err.' (HTTP '.$code.')');return $buf; }
function persistInstallJournal(string $path,array $journal):void{$tmp=$path.'.'.bin2hex(random_bytes(6)).'.tmp';$bytes=json_encode($journal,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR);if(file_put_contents($tmp,$bytes,LOCK_EX)!==strlen($bytes))throw new RuntimeException('Could not write installer transaction journal');@chmod($tmp,0600);if(!rename($tmp,$path)){@unlink($tmp);throw new RuntimeException('Could not publish installer transaction journal');}}
function journalBootstrapTransaction(string $target,string $path,array &$journal,string $journalPath):void{$prefix=rtrim($target,DIRECTORY_SEPARATOR).DIRECTORY_SEPARATOR.'inc/plugins/data/mybb-tooling/transactions'.DIRECTORY_SEPARATOR;if(!str_starts_with($path,$prefix))throw new RuntimeException('Bootstrap transaction path escaped the installer state directory');$relative='inc/plugins/data/mybb-tooling/transactions/'.basename($path);MyBB\Tooling\Manifest::validateRelativePath($relative);if(!preg_match('/^[a-z0-9][a-z0-9-]*-\d{14}-[a-f0-9]{6}$/D',basename($relative)))throw new RuntimeException('Bootstrap transaction directory name is invalid');$journal['bootstrap_transactions']??=[];if(!is_array($journal['bootstrap_transactions'])||!array_is_list($journal['bootstrap_transactions']))throw new RuntimeException('Installer transaction journal has an invalid bootstrap transaction list');if(!in_array($relative,$journal['bootstrap_transactions'],true)){$journal['bootstrap_transactions'][]=$relative;persistInstallJournal($journalPath,$journal);}}
function bootstrapJournalDigests(array $entry):array{return MyBB\Installer\InstallRecovery::bootstrapJournalDigests($entry);}
function removeBootstrapTransactionDirectories(string $target,array $relativePaths):array{return MyBB\Installer\InstallRecovery::removeBootstrapTransactionDirectories($target,$relativePaths);}
function findUnjournaledBootstrapTransactions(string $target):array{$root=$target.'/inc/plugins/data/mybb-tooling/transactions';if(!file_exists($root)&&!is_link($root))return [];if(is_link($root)||!is_dir($root))return ['inc/plugins/data/mybb-tooling/transactions'];$paths=[];try{foreach(new FilesystemIterator($root,FilesystemIterator::SKIP_DOTS) as $item)$paths[]='inc/plugins/data/mybb-tooling/transactions/'.$item->getFilename();}catch(Throwable){$paths[]='inc/plugins/data/mybb-tooling/transactions';}return $paths;}
function ensureInstallDirectories(string $target,string $relative,array &$journal,string $journalPath):void{if($relative==='.'||$relative==='')return;MyBB\Tooling\Manifest::validateRelativePath($relative);$cursor=$target;$built=[];foreach(explode('/',$relative) as $part){$built[]=$part;$cursor.=DIRECTORY_SEPARATOR.$part;if(is_link($cursor))throw new RuntimeException('Refusing a symlinked target directory: '.$relative);if(!is_dir($cursor)){$known=array_map('strtolower',$journal['directories']);$created=implode('/',$built);if(!in_array(strtolower($created),$known,true))$journal['directories'][]=$created;persistInstallJournal($journalPath,$journal);if(!@mkdir($cursor,0755))throw new RuntimeException('Could not create target directory: '.$relative);}$real=realpath($cursor);if($real===false||!str_starts_with($real,rtrim($target,DIRECTORY_SEPARATOR).DIRECTORY_SEPARATOR))throw new RuntimeException('Target directory resolved outside the install root: '.$relative);if(is_link($cursor))throw new RuntimeException('Refusing a symlinked target directory: '.$relative);}}
function rollbackInstallJournal(string $target,string $path):array
{
    $raw=@file_get_contents($path);
    if($raw===false)throw new RuntimeException('No installer transaction journal exists for this target');
    $journal=json_decode($raw,true,512,JSON_THROW_ON_ERROR);
    if(!is_array($journal)||($journal['schema_version']??null)!==1||($journal['target']??null)!==$target||!is_array($journal['files']??null))throw new RuntimeException('Installer transaction journal is invalid or belongs to another target');
    if(($journal['status']??'')==='complete')throw new RuntimeException('This installation is committed; rollback is not available through recover');
    $hasTransactionJournal=array_key_exists('bootstrap_transactions',$journal);
    $transactionPaths=$journal['bootstrap_transactions']??[];
    if(!is_array($transactionPaths)||!array_is_list($transactionPaths))throw new RuntimeException('Installer transaction journal has an invalid bootstrap transaction list');
    foreach($transactionPaths as $transactionPath){
        if(!is_string($transactionPath)||!str_starts_with($transactionPath,'inc/plugins/data/mybb-tooling/transactions/')||!preg_match('/^[a-z0-9][a-z0-9-]*-\d{14}-[a-f0-9]{6}$/D',basename($transactionPath)))throw new RuntimeException('Installer transaction journal contains an invalid bootstrap transaction path');
        MyBB\Tooling\Manifest::validateRelativePath($transactionPath);
    }
    $alreadyRolledBack=($journal['status']??'')==='rolled_back';
    $removed=$alreadyRolledBack?($journal['rollback_removed']??[]):[];
    $preserved=$alreadyRolledBack?($journal['rollback_preserved']??[]):[];
    $removedDirectories=[];
    if(!$alreadyRolledBack){
        foreach(array_reverse($journal['files']) as $entry){
            $relative=(string)($entry['path']??'');
            try{MyBB\Tooling\Manifest::validateRelativePath($relative);}catch(Throwable){$preserved[]=$relative?:'(invalid journal path)';continue;}
            $cursor=$target;$unsafe=false;$parts=explode('/',$relative);
            foreach($parts as $i=>$part){$cursor.=DIRECTORY_SEPARATOR.$part;if(is_link($cursor)){$unsafe=true;break;}if($i<count($parts)-1&&!is_dir($cursor)&&file_exists($cursor)){$unsafe=true;break;}}
            if($unsafe){$preserved[]=$relative;continue;}
            if(!file_exists($cursor))continue;
            $digest=(string)@hash_file('sha256',$cursor);
            if(!is_file($cursor)||!in_array($digest,bootstrapJournalDigests($entry),true)){$preserved[]=$relative;continue;}
            if(!@unlink($cursor)){$preserved[]=$relative;continue;}
            $removed[]=$relative;$dir=dirname($cursor);
            while($dir!==$target&&str_starts_with($dir,$target.DIRECTORY_SEPARATOR)){if(!@rmdir($dir))break;$dir=dirname($dir);}
        }
        foreach(array_reverse($journal['directories']??[]) as $relativeDir){
            try{MyBB\Tooling\Manifest::validateRelativePath((string)$relativeDir);}catch(Throwable){$preserved[]=(string)$relativeDir.' (invalid directory path)';continue;}
            $dirPath=$target;$unsafeDir=false;
            foreach(explode('/',(string)$relativeDir) as $part){$dirPath.=DIRECTORY_SEPARATOR.$part;if(is_link($dirPath)){$unsafeDir=true;break;}}
            if($unsafeDir){$preserved[]=(string)$relativeDir.' (symlinked directory)';continue;}
            if(is_dir($dirPath)){if(@rmdir($dirPath))$removedDirectories[]=(string)$relativeDir;else $preserved[]=(string)$relativeDir.' (directory is not empty)';}
        }
    }
    $removedTransactions=[];$preservedTransactions=[];
    if(!$hasTransactionJournal){
        $preservedTransactions=findUnjournaledBootstrapTransactions($target);
        foreach($preservedTransactions as $transactionPath)$preserved[]='untracked bootstrap transaction data preserved: '.$transactionPath;
    }elseif(!$preserved){
        $cleanup=removeBootstrapTransactionDirectories($target,$transactionPaths);
        $removedTransactions=$cleanup['removed'];$preservedTransactions=$cleanup['preserved'];
        foreach($preservedTransactions as $transactionPath)$preserved[]='bootstrap transaction recovery data: '.$transactionPath;
    }else $preservedTransactions=$transactionPaths;
    $journal['status']=$preserved?'rollback_incomplete':'rolled_back';
    $journal['rollback_removed_directories']=array_values(array_unique(array_merge($journal['rollback_removed_directories']??[],$removedDirectories)));
    $journal['rollback_removed']=array_values(array_unique($removed));
    $journal['rollback_preserved']=array_values(array_unique($preserved));
    $journal['rollback_removed_bootstrap_transactions']=array_values(array_unique(array_merge($journal['rollback_removed_bootstrap_transactions']??[],$removedTransactions)));
    if($hasTransactionJournal)$journal['bootstrap_transactions']=$preservedTransactions;
    $journal['recovered_at']=gmdate(DATE_ATOM);
    persistInstallJournal($path,$journal);
    return ['status'=>$journal['status'],'removed'=>$journal['rollback_removed'],'preserved'=>$journal['rollback_preserved'],'removed_transactions'=>$removedTransactions,'preserved_transactions'=>$preservedTransactions,'journal'=>$path];
}
function journalBootstrapWrites(string $target,array $packages,string $journalPath,array &$journal):callable
{
    $known=[];foreach($journal['files'] as $entry)$known[strtolower((string)$entry['path'])]=true;
    $add=static function(string $relative,string $digest,string $component)use(&$journal,&$known,$journalPath):void{
        MyBB\Tooling\Manifest::validateRelativePath($relative);$key=strtolower($relative);
        if(isset($known[$key])){foreach($journal['files'] as &$existing){if(strtolower((string)$existing['path'])===$key){if(($existing['component']??'')!=='bootstrap_state')throw new RuntimeException('Bootstrap path collides with an official MyBB file: '.$relative);$variants=bootstrapJournalDigests($existing);if(!in_array($digest,$variants,true))$variants[]=$digest;$existing['sha256']=$digest;if(count($variants)>1)$existing['sha256_variants']=$variants;$existing['status']='planned';unset($existing);persistInstallJournal($journalPath,$journal);return;}}unset($existing);throw new RuntimeException('Duplicate bootstrap destination: '.$relative);}
        $journal['files'][]=['path'=>$relative,'sha256'=>$digest,'status'=>'planned','component'=>$component];$known[$key]=true;persistInstallJournal($journalPath,$journal);
    };
    foreach($packages as $package){$archive=new ZipArchive();if($archive->open($package['zip'])!==true)throw new RuntimeException('Cannot open signed bootstrap archive for recovery planning');try{foreach($package['manifest']['files'] as $file){$contents=$archive->getFromName($file['source']);if($contents===false)throw new RuntimeException('Bootstrap archive is missing a declared source: '.$file['source']);$add($file['destination'],hash('sha256',$contents),'bootstrap_package');}}finally{$archive->close();}}
    $state='inc/plugins/data/mybb-tooling/';
    $add($state.'.htaccess',hash('sha256',"Require all denied\n"),'bootstrap_state');
    $add($state.'index.html',hash('sha256',''),'bootstrap_state');
    $add($state.'manager.lock',hash('sha256',''),'bootstrap_state');
    return static function(string $absolutePath,string $digest)use($target,$add):void{
        $root=rtrim($target,DIRECTORY_SEPARATOR).DIRECTORY_SEPARATOR;
        if(!str_starts_with($absolutePath,$root))throw new RuntimeException('Bootstrap state write escaped the installer target');
        $relative=str_replace(DIRECTORY_SEPARATOR,'/',substr($absolutePath,strlen($root)));
        $add($relative,$digest,'bootstrap_state');
    };
}
function removeBootstrapWritesForResume(string $target,string $journalPath,array &$journal):void
{
    MyBB\Installer\InstallRecovery::removeBootstrapWritesForResume($target,$journalPath,$journal,'persistInstallJournal');
}
function validateResumeTarget(string $target,array $journal):void
{
    $known=[];foreach($journal['files'] as $entry){$path=(string)($entry['path']??'');MyBB\Tooling\Manifest::validateRelativePath($path);$known[strtolower($path)]=true;}
    if(!is_dir($target))return;
    foreach(new RecursiveIteratorIterator(new RecursiveDirectoryIterator($target,FilesystemIterator::SKIP_DOTS)) as $item){$absolute=$item->getPathname();if($item->isLink())throw new RuntimeException('Cannot resume with symlinks in the target: '.$absolute);if(!$item->isFile())continue;$relative=str_replace(DIRECTORY_SEPARATOR,'/',substr($absolute,strlen(rtrim($target,DIRECTORY_SEPARATOR))+1));
        if(isset($known[strtolower($relative)]))continue;
        if(str_starts_with($relative,'inc/plugins/data/mybb-tooling/transactions/')){$tracked=$journal['bootstrap_transactions']??null;if($tracked===null)continue;$knownTransaction=false;foreach($tracked as $transactionPath)if(str_starts_with($relative,$transactionPath.'/')){$knownTransaction=true;break;}if($knownTransaction)continue;throw new RuntimeException('Cannot resume because the tooling state contains an unjournaled transaction artifact: '.$relative);}
        throw new RuntimeException('Cannot resume because the target contains an unjournaled file: '.$relative);
    }
}
function validateResumeJournal(array $journal,string $target):void
{
    if(($journal['schema_version']??null)!==1||($journal['target']??null)!==$target||!in_array(($journal['status']??''),['applying','files_ready','bootstrap_applying'],true)||!is_string($journal['version']??null)||!is_string($journal['source']??null)||!array_key_exists('core_sha512',$journal)||!is_bool($journal['core_only']??null)||!array_key_exists('bootstrap_package_sha256',$journal)||!array_key_exists('repository_package_sha256',$journal)||!is_array($journal['files']??null)||!is_array($journal['directories']??null))throw new RuntimeException('Installer transaction journal is invalid, committed, rolled back, or not resumable');
    if($journal['core_sha512']!==null&&(!is_string($journal['core_sha512'])||!preg_match('/^[a-f0-9]{128}$/',$journal['core_sha512'])))throw new RuntimeException('Installer transaction journal contains an invalid official checksum');
    if($journal['bootstrap_package_sha256']!==null&&(!is_string($journal['bootstrap_package_sha256'])||!preg_match('/^[a-f0-9]{64}$/',$journal['bootstrap_package_sha256'])))throw new RuntimeException('Installer transaction journal contains an invalid bootstrap digest');
    $known=[];foreach($journal['files'] as $entry){if(!is_array($entry)||!is_string($entry['path']??null)||!is_string($entry['sha256']??null)||!preg_match('/^[a-f0-9]{64}$/',$entry['sha256'])||!in_array(($entry['status']??''),['planned','applied'],true)||!in_array(($entry['component']??''),['mybb_core','bootstrap_package','bootstrap_state'],true))throw new RuntimeException('Installer transaction journal contains an invalid file record');MyBB\Tooling\Manifest::validateRelativePath($entry['path']);if(isset($entry['sha256_variants'])){if(($entry['component']??null)!=='bootstrap_state'||!is_array($entry['sha256_variants'])||!array_is_list($entry['sha256_variants']))throw new RuntimeException('Installer transaction journal contains invalid state-file digest variants');foreach($entry['sha256_variants'] as $digest)if(!is_string($digest)||!preg_match('/^[a-f0-9]{64}$/',$digest))throw new RuntimeException('Installer transaction journal contains an invalid state-file digest variant');}$pathKey=strtolower($entry['path']);if(isset($known[$pathKey]))throw new RuntimeException('Installer transaction journal contains duplicate normalized file paths');$known[$pathKey]=true;}
    foreach($journal['directories'] as $directory){if(!is_string($directory))throw new RuntimeException('Installer transaction journal contains an invalid directory record');MyBB\Tooling\Manifest::validateRelativePath($directory);}
    $transactions=$journal['bootstrap_transactions']??[];if(!is_array($transactions)||!array_is_list($transactions))throw new RuntimeException('Installer transaction journal contains an invalid bootstrap transaction list');foreach($transactions as $transaction){if(!is_string($transaction)||!str_starts_with($transaction,'inc/plugins/data/mybb-tooling/transactions/')||!preg_match('/^[a-z0-9][a-z0-9-]*-\d{14}-[a-f0-9]{6}$/D',basename($transaction)))throw new RuntimeException('Installer transaction journal contains an invalid bootstrap transaction path');MyBB\Tooling\Manifest::validateRelativePath($transaction);}
}
try {
 $args=array_slice($argv,1);$command=array_shift($args)??'help';$opts=[];$position=[];foreach($args as $a){if(str_starts_with($a,'--')){[$k,$v]=array_pad(explode('=',$a,2),2,true);$opts[ltrim($k,'-')]=$v;}else $position[]=$a;}
 if(in_array($command,['help','--help','-h'],true)){fwrite(STDOUT,"Usage: mybb-install check [PATH] | install --path=EMPTY_DIR [--setup-config=PROTECTED_JSON] [--version=X] [--bootstrap-dir=PATH] [--trusted-keys=PATH] [--dry-run] [--resume] [--allow-unverified] [--core-only] | configure --path=SITE [--setup-config=PROTECTED_JSON] | upgrade --path=SITE --backup-dir=EXISTING_DIR [--version=X] [--dry-run|--yes] | upgrade --path=SITE --resume --journal=FILE [--dry-run|--yes] | recover --path=TARGET --rollback | recover --upgrade-journal=FILE --rollback\n");exit(0);}
 if($command==='recover'){if(!isset($opts['rollback']))throw new InvalidArgumentException('Usage: mybb-install recover --path=TARGET --rollback or recover --upgrade-journal=FILE --rollback');if(isset($opts['upgrade-journal'])){$result=MyBB\Tooling\OfficialMyBBUpgrade::rollback((string)$opts['upgrade-journal']);}else{$target=resolveTargetPath((string)($opts['path']??$position[0]??throw new InvalidArgumentException('--path is required')));$result=rollbackInstallJournal($target,$target.'.mybb-install-transaction.json');}emit($result,($result['status']??'')==='rollback_incomplete'?1:0);}
 if($command==='configure'){$target=resolveTargetPath((string)($opts['path']??$position[0]??throw new InvalidArgumentException('--path is required')));$setupPath=(string)($opts['setup-config']??'');$setup=$setupPath!==''?MyBB\Installer\InitialSetup::loadConfig($setupPath,$target):MyBB\Installer\InitialSetup::prompt();emit(MyBB\Installer\InitialSetup::configure($target,$setup));}
 if($command==='check') {
  $target=resolveTargetPath((string)($opts['path']??$position[0]??getcwd()));
  $exists=is_dir($target);
  $free=@disk_free_space($exists?$target:dirname($target));
  $writable=$exists?is_writable($target):is_writable(dirname($target));
  $extensions=['curl'=>extension_loaded('curl'),'zip'=>extension_loaded('zip'),'sodium'=>extension_loaded('sodium'),'mysqli'=>extension_loaded('mysqli')];
  $markers=is_file($target.'/inc/config.php')&&is_file($target.'/global.php');
  $populated=$exists&&count(scandir($target))>2;
  $webAssumptions=[
   'status'=>'manual_review_required',
   'checks'=>[
    ['id'=>'document_root','status'=>'not_verifiable_from_cli','assumption'=>'Configure the web server document root to serve this MyBB site directory.'],
    ['id'=>'web_php_parity','status'=>'not_verifiable_from_cli','assumption'=>'The web PHP SAPI must provide a compatible PHP version and the required MyBB extensions reported for this CLI runtime.'],
    ['id'=>'backup_location','status'=>'manual','assumption'=>'Keep upgrade backups outside the public web root.'],
   ],
  ];
  $result=['php'=>PHP_VERSION,'php_sapi'=>PHP_SAPI,'php_supported'=>PHP_VERSION_ID>=80200,'extensions'=>$extensions,'curl'=>$extensions['curl'],'zip'=>$extensions['zip'],'sodium'=>$extensions['sodium'],'mysqli'=>$extensions['mysqli'],'archive_support'=>['zip_extension'=>$extensions['zip'],'zip_archive_class'=>class_exists(ZipArchive::class)],'target'=>$target,'target_exists'=>$exists,'target_writable'=>$writable,'target_populated'=>$populated,'mybb_detected'=>$markers,'installation_mode'=>$markers?'existing_mybb_detected':($populated?'refuse_populated_target':'fresh_install'),'free_bytes'=>$free===false?null:(int)$free,'required_free_bytes'=>100000000,'sufficient_free_space'=>$free!==false&&$free>=100000000,'web_server_assumptions'=>$webAssumptions,'read_only'=>true];
  $result['ready']=$result['php_supported']&&$extensions['curl']&&$extensions['zip']&&$result['archive_support']['zip_archive_class']&&$extensions['sodium']&&$extensions['mysqli']&&$result['target_writable']&&$result['sufficient_free_space']&&!($populated&&!$markers);
  if(jsonMode())emit($result,$result['ready']?0:1);
  foreach($result as $k=>$v)fwrite(STDOUT,$k.': '.(is_bool($v)?($v?'yes':'no'):(is_scalar($v)?(string)$v:json_encode($v,JSON_UNESCAPED_SLASHES)))."\n");
  exit($result['ready']?0:1);
 }
 if(!in_array($command,['install','upgrade'],true))throw new InvalidArgumentException('Commands: check, install, upgrade, recover');
 if(isset($opts['setup-config'])&&$command!=='install')throw new InvalidArgumentException('--setup-config applies only to install or configure.');
 if(isset($opts['core-only'])&&$command!=='install')throw new InvalidArgumentException('--core-only applies only to install');
 $target=resolveTargetPath((string)($opts['path']??$position[0]??throw new InvalidArgumentException('--path is required')));
 $resumeOption=isset($opts['resume']);$resumeRequested=$command==='install'&&$resumeOption;$upgradeResumeRequested=$command==='upgrade'&&$resumeOption;if($resumeOption&&!$resumeRequested&&!$upgradeResumeRequested)throw new InvalidArgumentException('--resume applies only to install or upgrade');if($resumeRequested&&isset($opts['dry-run']))throw new InvalidArgumentException('Install resume cannot be combined with --dry-run');
 $txn=$target.'.mybb-install-transaction.json';$resumeJournal=null;
 if($resumeRequested){$raw=@file_get_contents($txn);if($raw===false)throw new RuntimeException('No installer transaction journal exists to resume');$resumeJournal=json_decode($raw,true,512,JSON_THROW_ON_ERROR);if(!is_array($resumeJournal))throw new RuntimeException('Installer transaction journal is invalid');validateResumeJournal($resumeJournal,$target);validateResumeTarget($target,$resumeJournal);}
 $upgradeJournal=null;$currentVersion=null;$backupDirectory=null;
 if($command==='install'&&is_dir($target)&&count(scandir($target))>2&&!$resumeRequested)throw new RuntimeException('Install target is not empty; use the separate upgrade command for an existing MyBB site');
 if($command==='upgrade'){

#!/usr/bin/env php
<?php
declare(strict_types=1);
$loaded=false;for($dir=__DIR__;$dir!==dirname($dir);$dir=dirname($dir))if(is_file($dir.'/vendor/autoload.php')){require $dir.'/vendor/autoload.php';$loaded=true;break;}if(!$loaded){$fallback=dirname(__DIR__,2).'/autoload.php';if(!is_file($fallback)){fwrite(STDERR,"Shared tooling package is missing; install this project with Composer.\n");exit(1);}require $fallback;}
require_once dirname(__DIR__).'/src/InitialSetup.php';
require_once dirname(__DIR__).'/src/InstallPlanOutput.php';
